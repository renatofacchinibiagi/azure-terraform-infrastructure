# =============================================================================
# O QUE NAO PODE IR PARA O GIT (seguranca)
# =============================================================================

# Diretorio local do Terraform: plugins baixados e configuracao do backend
# (inclui o nome da Storage Account e dados de cache). Recriado pelo "terraform init".
**/.terraform/

# State e backups: contem o inventario completo da infraestrutura e podem
# conter segredos em texto puro. O state oficial fica no Azure Blob Storage.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Valores reais das variaveis (subscription, nomes, senhas, chaves).
# Somente os arquivos *.tfvars.example sao versionados.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Configuracao real do backend (nomes do armazenamento). Versione apenas o .example.
*.backend.hcl
backend.hcl
!*.backend.hcl.example
!backend.hcl.example

# Planos salvos: podem conter valores sensiveis
*.tfplan
*tfplan*

# Arquivos de override locais
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Configuracao local da CLI (pode conter tokens)
.terraformrc
terraform.rc

# Logs de falha, locks transitorios e saidas de debug
crash.log
crash.*.log
.terraform.tfstate.lock.info

# Segredos e credenciais comuns
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.publishsettings
*.auth.json
credentials.json

# Arquivos de editor e sistema operacional
.vscode/
.idea/
.DS_Store
Thumbs.db

# =============================================================================
# O QUE DEVE SER VERSIONADO (nao ignorar)
# =============================================================================
# - *.tf                  codigo da infraestrutura
# - .terraform.lock.hcl   versoes fixadas dos providers (reproducibilidade)
# - *.tfvars.example      exemplos de variaveis, sem valores reais
# - README e demais documentos
# - .github/workflows/    automacoes de CI
